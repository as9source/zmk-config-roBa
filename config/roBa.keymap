#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Keyball39 (Remap) の配置を移植したキーマップ
// レイヤー: 0 BASE / 1 FUNC / 2 NUM / 3 SCROLL（かな長押し中はボールでスクロール） / 4 SYSTEM（Bluetooth）
// roBa にしかない内側4キーのうち、左下段の内側を SYSTEM レイヤー呼び出しにしている

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <0>;
    scroll-layers = <3>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp Q     &kp W     &kp E      &kp R                &kp T                                                  &kp Y        &kp U        &kp I      &kp O    &kp P
&kp A     &kp S     &lt 1 D    &kp F                &kp G        &none               &none                 &kp H        &kp J        &kp K      &kp L    &kp MINUS
&kp Z     &kp X     &kp C      &kp V                &kp B        &mo 4               &none                 &kp N        &kp M        &kp COMMA  &kp DOT  &kp FSLH
&kp RALT  &kp LGUI  &kp LCTRL  &mt LSHIFT LANG2     &lt 1 SPACE  &lt 3 LANG1         &lt 1 BSPC            &lt 2 ENTER                                     &kp TAB
            >;
        };

        FUNC {
            bindings = <
&kp F1         &kp F2          &kp F3      &kp F4         &kp GRAVE                                     &kp F6         &kp F7     &kp F8     &kp F9    &kp F10
&kp F5         &kp LS(N1)      &kp LS(N6)  &kp LS(FSLH)   &kp LS(N8)  &trans          &trans            &kp LS(INT1)   &mkp MB1   &kp PG_UP  &mkp MB2  &gresc
&kp LS(EQUAL)  &kp LS(LBKT)    &kp LS(N7)  &kp LS(N2)     &kp LS(N9)  &trans          &trans            &kp LBKT       &kp LS(N4) &kp PG_DN  &mkp MB3  &kp F11
&kp INT1       &kp EQUAL       &kp LS(N3)  &kp LSHIFT     &trans      &trans          &to 0             &to 1                                           &kp F12
            >;
        };

        NUM {
            bindings = <
&kp TAB        &kp N7   &kp N8   &kp N9   &kp MINUS                                          &kp RBKT             &kp F1     &mkp MB3   &trans     &kp BSPC
&kp LS(SQT)    &kp N4   &kp N5   &kp N6   &kp LS(SEMI)    &trans          &trans             &kp BSLH             &mkp MB1   &kp UP     &mkp MB2   &kp SQT
&kp FSLH       &kp N1   &kp N2   &kp N3   &kp LS(MINUS)   &trans          &trans             &kp LS(NON_US_HASH)  &kp LEFT   &kp DOWN   &kp RIGHT  &trans
&kp ESC        &kp N0   &kp DOT  &kp DEL  &kp RSHIFT      &kp BSPC        &trans             &trans                                                &trans
            >;
        };

        SCROLL {
            bindings = <
&none  &none  &none  &none         &trans                                   &kp LS(LG(LEFT))   &none           &kp LG(TAB)  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))
&none  &none  &none  &none         &none        &trans        &trans        &kp LS(LG(RIGHT))  &none           &none        &none             &none
&none  &none  &none  &kp LS(COMMA) &kp LS(DOT)  &trans        &trans        &kp LC(LA(DEL))    &kp LS(LG(S))   &none        &none             &none
&none  &none  &trans &trans        &trans       &trans        &trans        &trans                                                             &kp N3
            >;
        };

        SYSTEM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader    &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
